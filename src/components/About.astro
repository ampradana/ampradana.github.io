---
import { about, profile } from '../data/site';

const stats = [
  { value: profile.experienceYears, label: 'Years in ERP' },
  { value: 'v10–v18', label: 'Odoo versions' },
  { value: '7+', label: 'Major projects' },
  { value: 'FMCG', label: 'Core industry' },
];
---

<section id="about" class="section">
  <div class="container">
    <p class="eyebrow">About</p>
    <h2 class="section-title">From technical to functional — end to end</h2>

    <div class="grid">
      <div class="prose reveal">
        {about.map((p) => <p>{p}</p>)}
      </div>

      <aside class="stats reveal">
        {stats.map((s) => (
          <div class="stat card">
            <span class="val">{s.value}</span>
            <span class="lbl">{s.label}</span>
          </div>
        ))}
      </aside>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .prose p { color: var(--muted); margin-bottom: 1.1rem; }
  .prose p:last-child { margin-bottom: 0; }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .stat {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .val { font-size: 1.5rem; font-weight: 700; color: var(--accent); letter-spacing: -0.02em; }
  .lbl { font-size: 0.82rem; color: var(--muted); }

  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; gap: 1.8rem; }
  }
</style>
