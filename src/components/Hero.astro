---
import { profile, social } from '../data/site';
---

<section id="top" class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    {profile.available && (
      <span class="badge reveal"><span class="dot"></span>{profile.availableText}</span>
    )}

    <img class="photo reveal" src={profile.photo} alt={profile.name} width="128" height="128" loading="eager" />

    <p class="greet reveal">Hi, I'm 👋</p>
    <h1 class="name reveal">{profile.name}</h1>
    <p class="role reveal">{profile.role}</p>
    <p class="pitch reveal">{profile.pitch}</p>

    <div class="cta reveal">
      <a href="#projects" class="btn btn-primary">View Projects</a>
      <a href={profile.cv} download class="btn btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
        Download CV
      </a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>

    <div class="socials reveal">
      <a href={social.github} target="_blank" rel="noopener" aria-label="GitHub" class="soc">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        <span>{social.githubHandle}</span>
      </a>
      <a href={social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="soc">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        <span>{social.linkedinHandle}</span>
      </a>
      <a href={`mailto:${social.email}`} aria-label="Email" class="soc">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        <span>Email</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    text-align: center;
    padding-top: 64px;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: min(820px, 95vw);
    height: 520px;
    background: radial-gradient(circle, var(--accent-tint), transparent 65%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }
  .photo {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    border: 2px solid var(--border-strong);
    box-shadow: 0 0 0 6px var(--accent-tint);
    margin: 0.5rem 0 1rem;
  }
  .greet { color: var(--muted); font-size: 1rem; }
  .name {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, var(--text), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .role {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 600;
    color: var(--accent);
    margin-top: 0.4rem;
  }
  .pitch {
    color: var(--muted);
    max-width: 640px;
    margin: 1rem auto 0;
    font-size: 1.02rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.8rem;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .soc {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }
  .soc:hover { color: var(--text); border-color: var(--accent); transform: translateY(-2px); }
  .reveal:nth-child(1) { transition-delay: 0s; }
  .reveal:nth-child(2) { transition-delay: 0.05s; }
  .reveal:nth-child(3) { transition-delay: 0.1s; }
  .reveal:nth-child(4) { transition-delay: 0.15s; }
  .reveal:nth-child(5) { transition-delay: 0.2s; }
</style>
